# Environnement de production - VPS Hostinger
# Copier en .env sur le VPS (jamais commiter le .env réel) : cp .env.production.example .env

NODE_ENV=production

# Server
PORT=5000

# Database - MongoDB Atlas (même cluster que la prod Render actuelle)
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.jodtq6h.mongodb.net/uemoa_energy_platform?retryWrites=true&w=majority&appName=Cluster0

# JWT
JWT_SECRET=changez_moi_cle_secrete_longue_et_aleatoire
JWT_EXPIRE=7d

# CORS - origine(s) autorisée(s), séparées par des virgules si plusieurs
# Remplacer par l'IP du VPS en attendant le domaine, puis par https://votre-domaine.com
CORS_ORIGIN=http://VOTRE_IP_OU_DOMAINE

# Email Configuration (Gmail example)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_app_password
EMAIL_FROM=noreply@uemoa-energy.org

# Upload (Cloudinary)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
