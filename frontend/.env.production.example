# Environnement de production - VPS Hostinger
# Copier en .env.production sur le VPS avant le build : cp .env.production.example .env.production

# Remplacer par l'IP du VPS en attendant le domaine, puis par https://votre-domaine.com/api
VITE_API_URL=http://VOTRE_IP_OU_DOMAINE/api
VITE_APP_NAME=UEMOA Energy Platform
